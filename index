<!-- ÇEVİRİ VE DİNLE -->
<div id="home" class="container active">
    <div class="card" style="text-align: center; padding-bottom: 40px;">
        <h2>Doruk'un Sesinden Hakemce</h2>
        <button class="btn btn-play" onclick="document.getElementById('dorukAudio').play()">
            🔊 DORUK'UN HAKEM DEMESİNİ DİNLE
        </button>
    </div>
    <div class="card">
        <h2>Canlı Hakemce Çeviri</h2>
        <textarea id="translatorInput" placeholder="Türkçe metni buraya girin (Örn: Yeteeeer!!!!)"></textarea>
        <div class="result-box" id="translatorOutput">...</div>
    </div>
</div>

<!-- AI BÖLÜMÜ (ÇAYDANLIK VS GERÇEK) -->
<div id="ai-bot" class="container">
    <div class="card" style="padding: 20px;">
        <h2>Yapay Zeka Seçimi</h2>
        
        <div class="ai-modes">
            <button class="ai-mode-btn active" id="btn-ciddi" onclick="setAiMode('ciddi')">🧠 Saçmalayamayan (Gerçek AI)</button>
            <button class="ai-mode-btn" id="btn-sacma" onclick="setAiMode('sacma')">🫖 Çaydanlık AI (Saçma)</button>
        </div>
        <div class="ai-status" id="ai-status">
