<!-- TESTLER -->
<div id="tests" class="container">
    <div class="card" id="test-menu">
        <h2>Antrenman Merkezi</h2>
        <div class="level-tabs">
            <button class="level-tab active" onclick="loadLevels('kolay')">Kolay Seviye</button>
            <button class="level-tab" onclick="loadLevels('orta')">Orta Seviye</button>
            <button class="level-tab" onclick="loadLevels('zor')">Zor Seviye</button>
        </div>
        <div class="test-modes">
            <button class="btn" style="flex:1" onclick="setMode('hazir')">Hazır Testler (100 Bölüm)</button>
            <button class="btn btn-outline" style="flex:1" onclick="setMode('duzenle')">⚙️ Düzenle (Özel Test)</button>
        </div>
        <div id="custom-settings" class="custom-settings">
            <h3>Testini Düzenle</h3>
            <div class="setting-group"><label>Soru Sayısı:</label> <input type="number" id="customQ" value="5" min="1" max="50"></div>
            <div class="setting-group"><label>Süre (Saniye):</label> <input type="number" id="customTime" value="60" min="10" max="300"></div>
            <button class="btn" style="width:100%" onclick="startCustomTest()">BAŞLA</button>
        </div>
        <div id="grid-container" class="grid-100"></div>
    </div>

    <!-- Aktif Sınav -->
    <div class="card" id="quiz-ui">
        <div class="quiz-header">
            <div id="quiz-timer">⏱️ Süre: 60s</div>
            <div id="quiz-progress">Soru: 1/10</div>
            <div id="quiz-score">Puan: 0</div>
        </div>
        <h3>Bu metni Hakemce'ye çevir:</h3>
        <div class="question-text" id="quiz-question">Yükleniyor...</div>
        <input type="text" id="quiz-input" class="quiz-input" placeholder="Cevabı yaz ve Enter'a bas..." autocomplete="off">
        <button class="btn" onclick="submitAnswer()" style="width:100%">CEVAPLA</button>
        <button class="btn btn-outline" onclick="endQuiz(false)" style="width:100%; margin-top: 10px;">TESTİ İPTAL ET</button>
    </div>
</div>

<script>
    /* ================= 1. ÇEVİRİ MOTORU ================= */
    function wordToHakem(word) {
        const match = word.match(/^([^a-zA-ZçğıöşüÇĞİÖŞÜ0-9]*)([a-zA-ZçğıöşüÇĞİÖŞÜ0-9]+)([^a-zA-ZçğıöşüÇĞİÖŞÜ0-9]*)$/);
        if (!match) return word;
        const prefix = match[1], coreWord = match[2], suffix = match[3];
        const isAllUpper = coreWord === coreWord.toUpperCase() && coreWord.length > 1;
        const isFirstUpper = coreWord.charAt(0) === coreWord.charAt(0).toUpperCase();

        let extraLength = coreWord.length - 5;
        let middleE = "e";
        if (extraLength > 0) middleE = "e".repeat(1 + extraLength);

        let hakemCore = "hak" + middleE + "m";
        if (isAllUpper) hakemCore = hakemCore.toUpperCase();
        else if (isFirstUpper) hakemCore = hakemCore.charAt(0).toUpperCase() + hakemCore.slice(1);
        return prefix + hakemCore + suffix;
    }

    function translateFullText(text) {
        if (!text) return "";
        return text.split(/\s+/).map(wordToHakem).join(' ');
    }

    document.getElementById('translatorInput').addEventListener('input', (e) => {
        document.getElementById('translatorOutput').innerText = translateFullText(e.target.value) || "...";
    });

    /* ================= HAKEM SPAWN EFEKTİ ================= */
    function spawnHakemWords() {
        const words = ["Hakem", "Hakeeem", "HAKEEEM", "Hakeeem...", "Hakem!"];
        for(let i=0; i<25; i++) {
            let el = document.createElement('div');
            el.className = 'floating-hakem';
            el.innerText = words[Math.floor(Math.random() * words.length)];
            el.style.left = Math.random() * 90 + "vw";
            el.style.top = (Math.random() * 80 + 10) + "vh"; // Ekranın ortalarında
            el.style.fontSize = (Math.random() * 30 + 15) + "px"; // Rastgele boyut
            
            // Rastgele açı ekleyelim
            let angle = Math.floor(Math.random() * 60) - 30; // -30 ile +30 derece arası
            el.style.transform = `rotate(${angle}deg)`;
            
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 2000); // Animasyon bitince sil
        }
    }

    /* ================= 2. ÇİFT MODLU AI (ÇAYDANLIK VS CİDDİ) ================= */
    const chatInput = document.getElementById('chatInput');
    const chatHistory = document.getElementById('chatHistory');
    const statusText = document.getElementById('ai-status');

    function setAiMode(mode) {
        document.getElementById('btn-ciddi').classList.remove('active');
        document.getElementById('btn-sacma').classList.remove('active');
        document.getElementById('btn-' + mode).classList.add('active');

        if(mode === 'sacma') {
            statusText.innerHTML = "🔴 Çaydanlık AI sunucusuna bağlanıldı...";
            statusText.style.color = "#e74c3c";
            // Kendi chat'imizi gizle, iframe'i göster
            document.getElementById('ai-chat-wrapper').style.display = 'none';
            document.getElementById('caydanlik-wrapper').style.display = 'block';
        } else {
            statusText.innerHTML = "🟢 İnternet bağlantısı tespit edildi! NLP motoru x10 hızla, apisiz çalışıyor.";
            statusText.style.color = "#2ecc71";
            // Iframe'i gizle, kendi chat'imizi göster
            document.getElementById('ai-chat-wrapper').style.display = 'flex';
            document.getElementById('caydanlik-wrapper').style.display = 'none';
        }
    }

    chatInput.addEventListener('keypress', e => { if(e.key === 'Enter') sendMessage(); });

    function sendMessage() {
        let text = chatInput.value.trim();
        if(!text) return;
        addMessage(text, 'user');
        chatInput.value = '';
        
        // SİHİRLİ EFEKT: Mesaj gönderince Hakem kelimeleri spawnlanır!
        spawnHakemWords();

        const loadingId = "msg-" + Date.now();
        addMessage("<span class='typing-indicator'>Yazıyor...</span>", 'bot', loadingId);

        // İnternet var simülasyonu için çok hızlı cevap (300ms)
        setTimeout(() => {
            const reply = generateSmartResponse(text);
            updateMessage(loadingId, reply);
        }, 400);
    }

    function generateSmartResponse(userInput) {
        let lowerInput = userInput.toLowerCase();

        if (lowerInput.includes("napiyorsun ayyy") || lowerInput.includes("napıyorsun") || lowerInput.includes("nasılsın")) {
            let translated = translateFullText(userInput);
            return `Hakeeem! İyiyim! 😊 Bak sen "${userInput}" dedin ya, bunun tam Hakemce çevirisi şöyle olur: <br><br><strong style="color:var(--primary); font-size:18px;">${translated}</strong>`;
        }
        if (lowerInput.includes("doruk kim") || lowerInput.includes("kim buldu")) {
            return "Doruk bu dilin yüce yaratıcısıdır! Çeviri sekmesinden sesini duyabilirsin.";
        }
        if (lowerInput.includes("çevir")) {
            let core = userInput.replace(/çevir/i, "").trim();
            if(core === "" || core === ":") core = "Ayy bir şey yazmadın ki çevireyim!";
            return `İşte Hakemcesi: <br><strong>${translateFullText(core)}</strong>`;
        }
        // Eğer belli bir kalıba uymuyorsa çevirisini ver.
        return `Hmm, anladım. Dediğin şeyin Hakemce çevirisi şudur: <br><strong>${translateFullText(userInput)}</strong>`;
    }

    function addMessage(text, sender, id = null) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `message ${sender === 'user' ? 'msg-user' : 'msg-bot'}`;
        if (id) msgDiv.id = id;
        msgDiv.innerHTML = sender === 'bot' ? `<span class="bot-name">🤖 Gerçek HakemBot</span>${text}` : text;
        chatHistory.appendChild(msgDiv); 
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function updateMessage(id, newText) {
        const msgDiv = document.getElementById(id);
        if (msgDiv) {
            msgDiv.innerHTML = `<span class="bot-name">🤖 Gerçek HakemBot</span>${newText}`;
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }
    }

    /* ================= 3. GELİŞMİŞ TEST MOTORU ================= */
    let currentLevel = 'kolay', quizInterval;
    let quizState = { active: false, questions: [], currentQIndex: 0, score: 0, timeLeft: 0, totalTime: 0, testId: null, totalQuestions: 0 };
    
    // YEPYENİ VE ZENGİNLEŞTİRİLMİŞ KELİME HAVUZU
    const vocab = {
        kolay: [
            "Selam", "Evet", "Hayır", "Tamam", "Pardon", "Merhaba", "Naber", 
            "Kim", "Ne", "Neden", "Güzel", "Kötü", "Oyun", "Maç", "Bitti", "Başla"
        ],
        orta: [
            "Nasılsın bugün?", "İtirazım var!", "Çok iyi", "Bir dakika.", "Anlamadım", 
            "Bence yanlış", "Hemen durdurun", "Kurallara aykırı", "Mat oldum", 
            "Şah çektim", "Hamle sırası bende", "Oyun bitti"
        ],
        zor: [
            "Hakem bey, sürem bittiği için kaybetmedim!!!", "Tebrikler, mükemmel oynadın...", 
            "Bu maçın sonucu tamamen yanlış hesaplanmış!", "O taş oraya oynanamaz, lütfen düzeltin!", 
            "Saat bozuk olduğu için ek süre talep ediyorum...", "Turnuva kurallarına göre bu beraberliktir!!!",
            "Napiyorsun ayyy, böyle hamle mi olur!"
        ]
    };

    function switchTab(tabId) {
        document.querySelectorAll('.container').forEach(el => el.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        document.querySelectorAll('nav button').forEach(el => el.classList.remove('active'));
        event.target.classList.add('active');
        if(tabId !== 'tests') endQuiz(false, true);
    }

    function loadLevels(level) {
        currentLevel = level;
        document.querySelectorAll('.level-tab').forEach(el => el.classList.remove('active'));
        event.target.classList.add('active');
        renderGrid();
    }

    function setMode(mode) {
        document.getElementById('custom-settings').style.display = mode === 'hazir' ? 'none' : 'block';
        document.getElementById('grid-container').style.display = mode === 'hazir' ? 'grid' : 'none';
    }

    function renderGrid() {
        const grid = document.getElementById('grid-container'); grid.innerHTML = '';
        for(let i=1; i<=100; i++) {
            const testId = `${currentLevel}_${i}`;
            const data = JSON.parse(localStorage.getItem('hakemce_' + testId));
            let statsHtml = '<span>Henüz çözülmedi</span>';
            if(data) statsHtml = `<span class="stars">${"★".repeat(data.stars) + "☆".repeat(3 - data.stars)}</span><span>Puan: ${data.score}</span>`;
            
            const btn = document.createElement('div'); btn.className = 'test-btn-wrapper';
            btn.onclick = () => startTest(testId);
            btn.innerHTML = `<div class="test-title">Test ${i}</div><div class="test-stats">${statsHtml}</div>`;
            grid.appendChild(btn);
        }
    }

    function startTest(testId) {
        let qCount = currentLevel === 'kolay' ? 5 : currentLevel === 'orta' ? 8 : 10;
        let time = currentLevel === 'kolay' ? 60 : currentLevel === 'orta' ? 90 : 120;
        quizState.testId = testId;
        initQuiz(currentLevel, qCount, time);
    }

    function startCustomTest() {
        quizState.testId = null;
        initQuiz(currentLevel, parseInt(document.getElementById('customQ').value), parseInt(document.getElementById('customTime').value));
    }

    function initQuiz(level, qCount, time) {
        quizState.questions = [];
        for(let i=0; i<qCount; i++) {
            let text = vocab[level][Math.floor(Math.random() * vocab[level].length)];
            // Testteki kelimelere biraz rastgele uzatma ve duygu ekleyelim
            if(Math.random() > 0.6) text = text.replace(/a/g, "aa").replace(/e/g, "ee") + (Math.random() > 0.5 ? "!!!" : "...");
            quizState.questions.push({ turkish: text, hakemce: translateFullText(text) });
        }
        quizState.totalQuestions = qCount; quizState.currentQIndex = 0; quizState.score = 0; quizState.timeLeft = time; quizState.totalTime = time; quizState.active = true;
        document.getElementById('test-menu').style.display = 'none'; document.getElementById('quiz-ui').style.display = 'block';
        updateQuizUI(); clearInterval(quizInterval); quizInterval = setInterval(timerTick, 1000);
        setTimeout(() => document.getElementById('quiz-input').focus(), 100);
    }

    function timerTick() {
        document.getElementById('quiz-timer').innerText = `⏱️ Süre: ${--quizState.timeLeft}s`;
        if(quizState.timeLeft <= 0) endQuiz(true);
    }

    function updateQuizUI() {
        if(quizState.currentQIndex >= quizState.totalQuestions) return endQuiz(true);
        document.getElementById('quiz-progress').innerText = `Soru: ${quizState.currentQIndex + 1}/${quizState.totalQuestions}`;
        document.getElementById('quiz-score').innerText = `Puan: ${quizState.score}`;
        document.getElementById('quiz-question').innerText = quizState.questions[quizState.currentQIndex].turkish;
        document.getElementById('quiz-input').value = ""; document.getElementById('quiz-input').focus();
    }

    document.getElementById('quiz-input').addEventListener('keypress', e => { if(e.key === 'Enter') submitAnswer(); });

    function submitAnswer() {
        if(!quizState.active) return;
        if(document.getElementById('quiz-input').value.trim() === quizState.questions[quizState.currentQIndex].hakemce) quizState.score += 10;
        else alert(`Yanlış!\nDoğru cevap: ${quizState.questions[quizState.currentQIndex].hakemce}`);
        quizState.currentQIndex++; updateQuizUI();
    }

    function endQuiz(finished, silent = false) {
        clearInterval(quizInterval); quizState.active = false;
        if(finished && !silent) {
            let accuracy = quizState.score / (quizState.totalQuestions * 10);
            let stars = accuracy === 1 ? 3 : accuracy >= 0.6 ? 2 : accuracy > 0 ? 1 : 0;
            if(quizState.testId) localStorage.setItem('hakemce_' + quizState.testId, JSON.stringify({ score: quizState.score, timeSpent: quizState.totalTime - quizState.timeLeft, stars: stars }));
            alert(`TEST BİTTİ!\nPuan: ${quizState.score}\nYıldız: ${stars}`);
        }
        document.getElementById('quiz-ui').style.display = 'none'; document.getElementById('test-menu').style.display = 'block'; renderGrid();
    }

    window.onload = () => loadLevels('kolay');
</script>

</body>
</html>
