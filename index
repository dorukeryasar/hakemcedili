<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hakemce Web Portalı (Ayran Baba Pro Edition)</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap');

        :root { --primary: #ff4757; --primary-dark: #ff1e32; --bg: #f1f2f6; --card-bg: #ffffff; --text-main: #2f3542; --text-muted: #747d8c; --gold: #ffa502; }
        body { font-family: 'Poppins', sans-serif; background-color: var(--bg); color: var(--text-main); margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; min-height: 100vh; overflow-x: hidden; }
        
        /* KOMİK REKLAMLAR (SADECE BİLGİSAYAR EKRANLARINDA) */
        .fake-ad { position: fixed; top: 150px; width: 160px; padding: 20px; background: white; border: 3px dashed var(--primary); text-align: center; font-weight: bold; font-size: 14px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); border-radius: 15px; z-index: 50; transform: rotate(-2deg); }
        .fake-ad.ad-left { left: 20px; transform: rotate(3deg); }
        .fake-ad.ad-right { right: 20px; transform: rotate(-3deg); }
        .ad-price { color: var(--primary); font-size: 20px; font-weight: 900; margin: 10px 0; }

        /* HEADER */
        header { width: 100%; background: var(--card-bg); padding: 15px 0; box-shadow: 0 4px 15px rgba(0,0,0,0.05); position: sticky; top: 0; z-index: 100; }
        .nav-container { max-width: 1000px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; flex-wrap: wrap; gap: 10px;}
        h1 { margin: 0; color: var(--primary); font-weight: 800; font-size: 24px; letter-spacing: 1px; }
        nav { gap: 10px; display: flex; flex-wrap: wrap;}
        nav button { background: transparent; border: none; font-size: 15px; font-weight: 600; color: var(--text-muted); cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: 0.3s; }
        nav button.active, nav button:hover { background: var(--bg); color: var(--primary); }

        /* CONTAINERS & CARDS */
        .container { max-width: 900px; width: 90%; margin: 30px auto; display: none; animation: fadeIn 0.4s ease-in-out; flex-grow: 1; position: relative; z-index: 10;}
        .container.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .card { background: var(--card-bg); padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-bottom: 30px; }
        h2 { margin-top: 0; font-size: 22px; color: var(--text-main); }
        p.info-text { line-height: 1.8; color: var(--text-muted); font-size: 15px; }

        /* BUTONLAR VE İNPUTLAR */
        .btn { background: var(--primary); color: white; border: none; padding: 12px 25px; font-size: 16px; font-weight: 600; border-radius: 10px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; justify-content: center; gap: 10px; }
        .btn:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255, 71, 87, 0.3); }
        .btn-play { background: #1e90ff; } .btn-play:hover { background: #0073e6; }
        .btn-outline { background: transparent; border: 2px solid var(--primary); color: var(--primary); }
        .btn-outline:hover { background: var(--primary); color: white; }
        textarea { width: 100%; height: 100px; padding: 15px; border: 2px solid #dfe4ea; border-radius: 12px; font-size: 16px; font-family: inherit; resize: none; margin-bottom: 15px; box-sizing: border-box; }
        textarea:focus { outline: none; border-color: var(--primary); }
        .result-box { background: var(--bg); padding: 20px; border-radius: 12px; font-size: 22px; font-weight: 600; min-height: 40px; word-wrap: break-word; }

        /* AI BÖLÜMÜ UI */
        .ai-modes { display: flex; gap: 10px; margin-bottom: 15px; }
        .ai-mode-btn { flex: 1; padding: 12px; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; background: #dfe4ea; transition: 0.3s; }
        .ai-mode-btn.active { background: var(--primary); color: white; }
        .ai-status { font-size: 12px; font-weight: bold; color: #2ecc71; margin-bottom: 15px; display: flex; align-items: center; gap: 5px; }
        
        .chat-container { display: flex; flex-direction: column; height: 450px; border: 2px solid #dfe4ea; border-radius: 15px; overflow: hidden; background: white; }
        .chat-history { flex: 1; padding: 20px; overflow-y: auto; background: #f8f9fa; display: flex; flex-direction: column; gap: 15px; }
        .message { max-width: 75%; padding: 12px 18px; border-radius: 15px; font-size: 15px; line-height: 1.5; animation: popIn 0.3s ease-out; }
        @keyframes popIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        .msg-user { background: var(--primary); color: white; align-self: flex-end; border-bottom-right-radius: 4px; }
        .msg-bot { background: white; border: 1px solid #dfe4ea; color: var(--text-main); align-self: flex-start; border-bottom-left-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .bot-name { font-weight: bold; color: var(--gold); font-size: 12px; margin-bottom: 5px; display: block; }
        .chat-input-area { display: flex; padding: 15px; background: white; border-top: 1px solid #dfe4ea; gap: 10px; }
        .chat-input-area input { flex: 1; padding: 12px; border: 1px solid #ccc; border-radius: 10px; font-size: 15px; outline: none; }
        .typing-indicator { color: var(--primary); font-weight: bold; animation: blink 1s infinite; }

        /* ÇAYDANLIK IFRAME KISMI */
        #caydanlik-wrapper { display: none; height: 450px; border: 2px solid #dfe4ea; border-radius: 15px; overflow: hidden; }

        /* HAKEM SPAWN EFEKTİ */
        .floating-hakem { position: fixed; pointer-events: none; color: var(--primary); font-weight: 900; z-index: 9999; animation: floatUp 2s forwards ease-out; text-shadow: 2px 2px 5px rgba(0,0,0,0.2); }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); } 100% { opacity: 0; transform: translateY(-150px) scale(1.5) rotate(20deg); } }

        /* TEST SİSTEMİ UI */
        .level-tabs { display: flex; gap: 10px; margin-bottom: 20px; }
        .level-tab { flex: 1; padding: 15px; border: none; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; background: #dfe4ea; transition: 0.3s; }
        .level-tab.active { background: var(--primary); color: white; }
        .test-modes { display: flex; gap: 15px; margin-bottom: 20px; background: var(--bg); padding: 15px; border-radius: 15px;}
        .grid-100 { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; max-height: 400px; overflow-y: auto; padding-right: 10px; }
        .test-btn-wrapper { background: white; border: 2px solid #dfe4ea; border-radius: 12px; padding: 15px; text-align: center; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; justify-content: space-between; min-height: 90px;}
        .test-btn-wrapper:hover { border-color: var(--primary); transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.1);}
        .test-title { font-weight: bold; font-size: 18px; margin-bottom: 5px; }
        .test-stats { font-size: 12px; color: var(--text-muted); display: flex; flex-direction: column; gap: 2px;}
        .stars { color: var(--gold); font-size: 14px; letter-spacing: 2px; }

        #quiz-ui { display: none; text-align: center; }
        .quiz-header { display: flex; justify-content: space-between; font-weight: bold; font-size: 18px; margin-bottom: 20px; background: var(--bg); padding: 15px; border-radius: 10px;}
        .question-text { font-size: 24px; font-weight: bold; margin: 20px 0; padding: 20px; background: #f8f9fa; border-radius: 12px; border-left: 5px solid var(--primary); }
        .quiz-input { width: 100%; font-size: 20px; padding: 15px; border: 2px solid var(--primary); border-radius: 10px; margin-bottom: 20px; text-align: center; box-sizing: border-box; }
        .custom-settings { display: none; background: #f8f9fa; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px dashed #ccc; }
        .setting-group { margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        .setting-group input { width: 80px; padding: 8px; border-radius: 8px; border: 1px solid #ccc; text-align: center; }

        /* MOBİL CİHAZLAR İÇİN RESPONSIVE TASARIM (Telefon Uyumluluğu) */
        @media (max-width: 1024px) {
            .fake-ad { display: none; } /* Yanlardaki reklamları mobilde kapat */
        }
        
        @media (max-width: 768px) {
            .nav-container { flex-direction: column; text-align: center; gap: 15px; padding: 10px; }
            nav { justify-content: center; width: 100%; gap: 5px; }
            nav button { font-size: 13px; padding: 8px 10px; flex: 1; }
            h1 { font-size: 20px; }
            
            .container { width: 95%; margin: 15px auto; }
            .card { padding: 20px; margin-bottom: 15px; }
            h2 { font-size: 18px; }
            
            .btn { width: 100%; font-size: 15px; padding: 10px 15px; margin-bottom: 10px; }
            .btn-outline { margin-top: 5px; }
            
            .ai-modes { flex-direction: column; }
            .chat-container { height: 400px; }
            #caydanlik-wrapper { height: 400px; }
            .message { max-width: 85%; font-size: 14px; }
            
            .level-tabs { flex-direction: column; gap: 5px; }
            .test-modes { flex-direction: column; gap: 5px; }
            .grid-100 { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; }
            .test-btn-wrapper { padding: 10px; min-height: 80px; }
            .test-title { font-size: 15px; }
            
            .question-text { font-size: 18px; padding: 15px; }
            .quiz-header { flex-direction: column; gap: 10px; font-size: 15px; text-align: center; }
        }
    </style>
</head>
<body>

<!-- SAĞ SOL KOMİK REKLAMLAR (Sadece PC'de görünür) -->
<div class="fake-ad ad-left">
    🥤 <strong>AYRAN BABA PRO</strong><br>Artık Sizlerle!<br><br>
    <div class="ad-price">Numara:<br>67676767(67)67</div>
    <small>İçen hakemler çok mutlu!</small>
</div>

<div class="fake-ad ad-right">
